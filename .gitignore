# ReXGlue codegen output - regenerated on every build from the manifest.
generated/

# Build trees
out/
build/

# Logs written next to the built exe
logs/

# Local scratch
*.log
codegen.build.stamp

# --- Never commit these -------------------------------------------------------
#
# Game content from the retail release. ~6.6 GB, of which bigfile1.big and
# bigfile2.big are 3.0 GB and 3.4 GB single files. Two independent reasons:
#   * GitHub hard-fails any blob over 100 MB, so a commit containing these
#     would be rejected outright.
#   * This is copyrighted commercial game data. It has no business in a
#     public repository and cannot be redistributed.
# Point --game_data_root at your own copy instead; the path is never hardcoded.
TDU2/

# The ReXGlue SDK is a separate, third-party project with its own releases
# (~199 MB of prebuilt headers/libs/toolchain). Fetch it per build.cmd rather
# than vendoring it into this repository.
rexglue/

# SDK source tree (cloned for debugging; use the patch file instead)
/rexglue-sdk/

# --- Debugging captures and binary dumps --------------------------------------
# Real console RAM dumps (up to 480 MB each)
Real\ Dumps/
# RenderDoc captures (~350 MB each)
TDU2\ Renderdoc/
# Extracted shader/vertex dump files
shader_dumps/
vertex_dumps/
# Automated screenshot captures (many MB each, generated per test run)
_intro_*.jpg
_intro_*.png
_crop_*.png
_shot_*.jpg
_screenshot_small.png
_verify_*.png
avatar_preview.png
# Extracted/embedded images
thumb.jpg
# Build output captured to files
_build_err.txt
_build_out.txt
# Tmp/scratch files
_pending_restore.txt
_paths.txt
_strings_out.txt
_perf_build.log
_sdk_build.log
_sdk_cfg.log