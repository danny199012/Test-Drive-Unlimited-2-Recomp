+void ImGuiDrawer::OnGamepadEvent(GamepadEvent& e) {
+  auto& io = GetIO();
+  if (!e.is_axis()) {
+    ImGuiKey key;
+    switch (e.button()) {
+      case GamepadEvent::Button::kA:
+        key = ImGuiKey_GamepadFaceDown;
+        break;
+      case GamepadEvent::Button::kB:
+        key = ImGuiKey_GamepadFaceRight;
+        break;
+      case GamepadEvent::Button::kX:
+        key = ImGuiKey_GamepadFaceLeft;
+        break;
+      case GamepadEvent::Button::kY:
+        key = ImGuiKey_GamepadFaceUp;
+        break;
+      case GamepadEvent::Button::kBack:
+        key = ImGuiKey_GamepadBack;
+        break;
+      case GamepadEvent::Button::kStart:
+        key = ImGuiKey_GamepadStart;
+        break;
+      case GamepadEvent::Button::kLeftThumb:
+        key = ImGuiKey_GamepadL3;
+        break;
+      case GamepadEvent::Button::kRightThumb:
+        key = ImGuiKey_GamepadR3;
+        break;
+      case GamepadEvent::Button::kLeftShoulder:
+        key = ImGuiKey_GamepadL1;
+        break;
+      case GamepadEvent::Button::kRightShoulder:
+        key = ImGuiKey_GamepadR1;
+        break;
+      case GamepadEvent::Button::kDpadUp:
+        key = ImGuiKey_GamepadDpadUp;
+        break;
+      case GamepadEvent::Button::kDpadDown:
+        key = ImGuiKey_GamepadDpadDown;
+        break;
+      case GamepadEvent::Button::kDpadLeft:
+        key = ImGuiKey_GamepadDpadLeft;
+        break;
+      case GamepadEvent::Button::kDpadRight:
+        key = ImGuiKey_GamepadDpadRight;
+        break;
+      default:
+        return;
+    }
+    io.AddKeyEvent(key, e.is_down());
+    return;
+  }
+  // Same dead zone as the Dear ImGui example backends.
+  constexpr float kDeadZone = 0.25f;
+  auto analog = [&io](ImGuiKey negative, ImGuiKey positive, float value) {
+    float magnitude = std::abs(value);
+    float strength = magnitude > kDeadZone ? (magnitude - kDeadZone) / (1.0f - kDeadZone) : 0.0f;
+    io.AddKeyAnalogEvent(negative, value < 0.0f && strength > 0.0f, value < 0.0f ? strength : 0.0f);
+    io.AddKeyAnalogEvent(positive, value > 0.0f && strength > 0.0f, value > 0.0f ? strength : 0.0f);
+  };
+  switch (e.axis()) {
+    case GamepadEvent::Axis::kLeftX:
+      analog(ImGuiKey_GamepadLStickLeft, ImGuiKey_GamepadLStickRight, e.value());
+      break;
+    case GamepadEvent::Axis::kLeftY:
+      analog(ImGuiKey_GamepadLStickUp, ImGuiKey_GamepadLStickDown, e.value());
+      break;
+    case GamepadEvent::Axis::kRightX:
+      analog(ImGuiKey_GamepadRStickLeft, ImGuiKey_GamepadRStickRight, e.value());
+      break;
+    case GamepadEvent::Axis::kRightY:
+      analog(ImGuiKey_GamepadRStickUp, ImGuiKey_GamepadRStickDown, e.value());
+      break;
+    case GamepadEvent::Axis::kLeftTrigger:
+      io.AddKeyAnalogEvent(ImGuiKey_GamepadL2, e.value() > 0.1f, e.value());
+      break;
+    case GamepadEvent::Axis::kRightTrigger:
+      io.AddKeyAnalogEvent(ImGuiKey_GamepadR2, e.value() > 0.1f, e.value());
+      break;
+  }
+}
