+void WindowSDL::HandleGamepadEvent(SDL_Event& event) {
+  WindowDestructionReceiver destruction_receiver(this);
+  if (event.type == SDL_EVENT_GAMEPAD_AXIS_MOTION) {
+    GamepadEvent::Axis axis;
+    switch (event.gaxis.axis) {
+      case SDL_GAMEPAD_AXIS_LEFTX:
+        axis = GamepadEvent::Axis::kLeftX;
+        break;
+      case SDL_GAMEPAD_AXIS_LEFTY:
+        axis = GamepadEvent::Axis::kLeftY;
+        break;
+      case SDL_GAMEPAD_AXIS_RIGHTX:
+        axis = GamepadEvent::Axis::kRightX;
+        break;
+      case SDL_GAMEPAD_AXIS_RIGHTY:
+        axis = GamepadEvent::Axis::kRightY;
+        break;
+      case SDL_GAMEPAD_AXIS_LEFT_TRIGGER:
+        axis = GamepadEvent::Axis::kLeftTrigger;
+        break;
+      case SDL_GAMEPAD_AXIS_RIGHT_TRIGGER:
+        axis = GamepadEvent::Axis::kRightTrigger;
+        break;
+      default:
+        return;
+    }
+    // Sticks are [-32768, 32767], triggers [0, 32767].
+    float value = std::clamp(float(event.gaxis.value) / 32767.0f, -1.0f, 1.0f);
+    GamepadEvent e = GamepadEvent::MakeAxis(this, axis, value);
+    OnGamepadEvent(e, destruction_receiver);
+    return;
+  }
+  GamepadEvent::Button button;
+  switch (event.gbutton.button) {
+    case SDL_GAMEPAD_BUTTON_SOUTH:
+      button = GamepadEvent::Button::kA;
+      break;
+    case SDL_GAMEPAD_BUTTON_EAST:
+      button = GamepadEvent::Button::kB;
+      break;
+    case SDL_GAMEPAD_BUTTON_WEST:
+      button = GamepadEvent::Button::kX;
+      break;
+    case SDL_GAMEPAD_BUTTON_NORTH:
+      button = GamepadEvent::Button::kY;
+      break;
+    case SDL_GAMEPAD_BUTTON_BACK:
+      button = GamepadEvent::Button::kBack;
+      break;
+    case SDL_GAMEPAD_BUTTON_GUIDE:
+      button = GamepadEvent::Button::kGuide;
+      break;
+    case SDL_GAMEPAD_BUTTON_START:
+      button = GamepadEvent::Button::kStart;
+      break;
+    case SDL_GAMEPAD_BUTTON_LEFT_STICK:
+      button = GamepadEvent::Button::kLeftThumb;
+      break;
+    case SDL_GAMEPAD_BUTTON_RIGHT_STICK:
+      button = GamepadEvent::Button::kRightThumb;
+      break;
+    case SDL_GAMEPAD_BUTTON_LEFT_SHOULDER:
+      button = GamepadEvent::Button::kLeftShoulder;
+      break;
+    case SDL_GAMEPAD_BUTTON_RIGHT_SHOULDER:
+      button = GamepadEvent::Button::kRightShoulder;
+      break;
+    case SDL_GAMEPAD_BUTTON_DPAD_UP:
+      button = GamepadEvent::Button::kDpadUp;
+      break;
+    case SDL_GAMEPAD_BUTTON_DPAD_DOWN:
+      button = GamepadEvent::Button::kDpadDown;
+      break;
+    case SDL_GAMEPAD_BUTTON_DPAD_LEFT:
+      button = GamepadEvent::Button::kDpadLeft;
+      break;
+    case SDL_GAMEPAD_BUTTON_DPAD_RIGHT:
+      button = GamepadEvent::Button::kDpadRight;
+      break;
+    default:
+      return;
+  }
+  GamepadEvent e =
+      GamepadEvent::MakeButton(this, button, event.type == SDL_EVENT_GAMEPAD_BUTTON_DOWN);
+  OnGamepadEvent(e, destruction_receiver);
+}
