+// A host gamepad button or axis change, for UI navigation. Not tied to any
+// window by the platform, so it is delivered to every window. Guest input
+// reads gamepads through the input drivers independently of these events.
+class GamepadEvent : public UIEvent {
+ public:
+  enum class Button {
+    kA,
+    kB,
+    kX,
+    kY,
+    kBack,
+    kGuide,
+    kStart,
+    kLeftThumb,
+    kRightThumb,
+    kLeftShoulder,
+    kRightShoulder,
+    kDpadUp,
+    kDpadDown,
+    kDpadLeft,
+    kDpadRight,
+  };
+  enum class Axis {
+    kLeftX,
+    kLeftY,
+    kRightX,
+    kRightY,
+    kLeftTrigger,
+    kRightTrigger,
+  };
+
+  static GamepadEvent MakeButton(Window* target, Button button, bool is_down) {
+    GamepadEvent e(target);
+    e.is_axis_ = false;
+    e.button_ = button;
+    e.is_down_ = is_down;
+    return e;
+  }
+  // Sticks are in [-1, 1] with positive Y pointing down, triggers in [0, 1].
+  static GamepadEvent MakeAxis(Window* target, Axis axis, float value) {
+    GamepadEvent e(target);
+    e.is_axis_ = true;
+    e.axis_ = axis;
+    e.value_ = value;
+    return e;
+  }
+
+  bool is_handled() const { return handled_; }
+  void set_handled(bool value) { handled_ = value; }
+
+  bool is_axis() const { return is_axis_; }
+  Button button() const { return button_; }
+  bool is_down() const { return is_down_; }
+  Axis axis() const { return axis_; }
+  float value() const { return value_; }
+
+ private:
+  explicit GamepadEvent(Window* target) : UIEvent(target) {}
+
+  bool handled_ = false;
+  bool is_axis_ = false;
+  Button button_ = Button::kA;
+  bool is_down_ = false;
+  Axis axis_ = Axis::kLeftX;
+  float value_ = 0.0f;
+};
+
 }  // namespace ui
 }  // namespace rex
