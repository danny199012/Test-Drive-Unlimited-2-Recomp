# Normalise text in the repository; check out platform-native endings.
#
# Batch files are the exception: cmd.exe misparses LF-only line endings
# (labels and `goto` silently break). Force CRLF for them regardless of
# platform so they always run on Windows.
* text=auto
build.cmd      text eol=crlf
play.bat       text eol=crlf
perf_test.bat  text eol=crlf

*.cpp text
*.h   text
*.py  text
*.md  text
*.toml text
*.json text
*.txt text

# Never rewrite these as text.
*.png binary
*.jpg binary

# git format-patch files must keep LF line endings for git am.
*.patch -text
